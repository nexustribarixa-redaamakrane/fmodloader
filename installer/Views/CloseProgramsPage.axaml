<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:FModLoaderInstaller.ViewModels"
             xmlns:ctrl="clr-namespace:FModLoaderInstaller.Controls"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="350"
             x:Class="FModLoaderInstaller.Views.CloseProgramsPage"
             x:DataType="vm:CloseProgramsPageViewModel">
  <Grid>
    <ctrl:SurgicalPatternOverlay ShowCrossHatch="False" ShowDotGrid="True" PatternOpacity="0.02" />

    <StackPanel Margin="24" Spacing="16" VerticalAlignment="Center">
      <!-- Header -->
      <StackPanel Spacing="4">
        <TextBlock Text="{Binding PageTitle}"
                   FontFamily="{StaticResource GoogleSans}"
                   FontSize="{StaticResource TitleLargeSize}"
                   FontWeight="Bold"
                   Foreground="{StaticResource PrimaryBrush}" />
        <TextBlock Text="{Binding PageSubtitle}"
                   FontFamily="{StaticResource GoogleSansFlexText}"
                   FontSize="{StaticResource BodyMediumSize}"
                   Foreground="{StaticResource OnSurfaceVariantBrush}" />
      </StackPanel>

      <!-- Running processes list -->
      <Border Background="{StaticResource SurfaceContainerLowBrush}"
              BorderBrush="{StaticResource OutlineVariantBrush}"
              BorderThickness="1"
              CornerRadius="10"
              Padding="12"
              MaxHeight="140"
              Margin="0,8,0,0"
              IsVisible="{Binding HasRunningProcesses}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding RunningProcesses}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="Auto,*" Margin="0,4">
                  <!-- Red dot indicator -->
                  <Ellipse Grid.Column="0"
                           Width="8" Height="8"
                           Fill="{StaticResource ErrorBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>
                  <TextBlock Grid.Column="1"
                             Text="{Binding}"
                             FontFamily="{StaticResource GoogleSansCode}"
                             FontSize="{StaticResource BodyMediumSize}"
                             Foreground="{StaticResource OnSurfaceBrush}"
                             VerticalAlignment="Center"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Border>

      <!-- All clear state -->
      <Border Background="{StaticResource SurfaceContainerLowBrush}"
              BorderBrush="{StaticResource OutlineVariantBrush}"
              BorderThickness="1"
              CornerRadius="10"
              Padding="16,12"
              Margin="0,8,0,0"
              IsVisible="{Binding !HasRunningProcesses}">
        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
          <Ellipse Width="10" Height="10"
                   Fill="{StaticResource TertiaryBrush}"
                   VerticalAlignment="Center"/>
          <TextBlock Text="No programs need to be closed — you may proceed."
                     FontFamily="{StaticResource GoogleSansFlexText}"
                     FontSize="{StaticResource BodyMediumSize}"
                     Foreground="{StaticResource OnSurfaceBrush}"
                     VerticalAlignment="Center"/>
        </StackPanel>
      </Border>

      <!-- Hint -->
      <TextBlock Text="Setup is scanning every 2 seconds. Close fModLoader and any related processes to continue."
                 FontFamily="{StaticResource GoogleSansFlexText}"
                 FontSize="{StaticResource BodySmallSize}"
                 Foreground="{StaticResource OnSurfaceVariantBrush}"
                 TextWrapping="Wrap"
                 Margin="4,4,0,0" />
    </StackPanel>
  </Grid>
</UserControl>
