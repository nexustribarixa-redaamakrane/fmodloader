<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ═══════════════════════════════════════════════════════════════════════
       MD3 EXPRESSIVE — Typography Scale (30 styles)
       Google Sans / Google Sans Flex / Google Sans Code
       ═══════════════════════════════════════════════════════════════════════ -->

  <!-- ── Custom Font Families ───────────────────────────────────────────── -->
  <!-- Variable Fonts (Folder scan) -->
  <FontFamily x:Key="GoogleSans">avares://fModLoader/Assets/Fonts/Google_Sans#Google Sans, Segoe UI, Arial, sans-serif</FontFamily>
  <FontFamily x:Key="GoogleSansFlex">avares://fModLoader/Assets/Fonts/Google_Sans_Flex#Google Sans Flex, Segoe UI, Arial, sans-serif</FontFamily>
  <FontFamily x:Key="GoogleSansCode">avares://fModLoader/Assets/Fonts/Google_Sans_Code#Google Sans Code, Consolas, Courier New, monospace</FontFamily>

  <!-- Variable Fonts (Specific files) -->
  <FontFamily x:Key="GoogleSansVariable">avares://fModLoader/Assets/Fonts/Google_Sans/GoogleSans-VariableFont_GRAD,opsz,wght.ttf#Google Sans, Segoe UI, Arial, sans-serif</FontFamily>
  <FontFamily x:Key="GoogleSansItalicVariable">avares://fModLoader/Assets/Fonts/Google_Sans/GoogleSans-Italic-VariableFont_GRAD,opsz,wght.ttf#Google Sans, Segoe UI, Arial, sans-serif</FontFamily>
  <FontFamily x:Key="GoogleSansFlexVariable">avares://fModLoader/Assets/Fonts/Google_Sans_Flex/GoogleSansFlex-VariableFont_GRAD,ROND,opsz,slnt,wdth,wght.ttf#Google Sans Flex, Segoe UI, Arial, sans-serif</FontFamily>
  <FontFamily x:Key="GoogleSansCodeVariable">avares://fModLoader/Assets/Fonts/Google_Sans_Code/GoogleSansCode-VariableFont_MONO,wght.ttf#Google Sans Code, Consolas, Courier New, monospace</FontFamily>
  <FontFamily x:Key="GoogleSansCodeItalicVariable">avares://fModLoader/Assets/Fonts/Google_Sans_Code/GoogleSansCode-Italic-VariableFont_MONO,wght.ttf#Google Sans Code, Consolas, Courier New, monospace</FontFamily>

  <!-- Static Fonts (Display optical size — for headlines/titles) -->
  <FontFamily x:Key="GoogleSansStatic">avares://fModLoader/Assets/Fonts/Google_Sans/static#Google Sans, Segoe UI, Arial, sans-serif</FontFamily>
  <FontFamily x:Key="GoogleSansFlexStatic">avares://fModLoader/Assets/Fonts/Google_Sans_Flex/static#Google Sans Flex, Segoe UI, Arial, sans-serif</FontFamily>
  <FontFamily x:Key="GoogleSansCodeStatic">avares://fModLoader/Assets/Fonts/Google_Sans_Code/static#Google Sans Code, Consolas, Courier New, monospace</FontFamily>

  <!-- Text-optimized Statics (17pt/24pt optical size — for body/text) -->
  <FontFamily x:Key="GoogleSansText">avares://fModLoader/Assets/Fonts/Google_Sans/static#Google Sans 17pt, Google Sans, Segoe UI, Arial, sans-serif</FontFamily>
  <FontFamily x:Key="GoogleSansFlexText">avares://fModLoader/Assets/Fonts/Google_Sans_Flex/static#Google Sans Flex 24pt, Google Sans Flex, Segoe UI, Arial, sans-serif</FontFamily>

  <!-- ── Display ─────────────────────────────────────────────────────────── -->
  <!-- Display Large: 57px, Google Sans Regular -->
  <x:Double x:Key="DisplayLargeSize">57</x:Double>
  <x:Double x:Key="DisplayMediumSize">45</x:Double>
  <x:Double x:Key="DisplaySmallSize">36</x:Double>

  <!-- ── Headline ────────────────────────────────────────────────────────── -->
  <x:Double x:Key="HeadlineLargeSize">32</x:Double>
  <x:Double x:Key="HeadlineMediumSize">28</x:Double>
  <x:Double x:Key="HeadlineSmallSize">24</x:Double>

  <!-- ── Title ───────────────────────────────────────────────────────────── -->
  <x:Double x:Key="TitleLargeSize">22</x:Double>
  <x:Double x:Key="TitleMediumSize">16</x:Double>
  <x:Double x:Key="TitleSmallSize">14</x:Double>

  <!-- ── Body ────────────────────────────────────────────────────────────── -->
  <x:Double x:Key="BodyLargeSize">18</x:Double>
  <x:Double x:Key="BodyMediumSize">17</x:Double>
  <x:Double x:Key="BodySmallSize">14</x:Double>

  <!-- ── Label ───────────────────────────────────────────────────────────── -->
  <x:Double x:Key="LabelLargeSize">14</x:Double>
  <x:Double x:Key="LabelMediumSize">12</x:Double>
  <x:Double x:Key="LabelSmallSize">11</x:Double>

</ResourceDictionary>
