<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ═══════════════════════════════════════════════════════════════════════
       MD3 EXPRESSIVE — Surgical Red & White Color Palette
       fModLoader branded tokens
       ═══════════════════════════════════════════════════════════════════════ -->

  <!-- ── Primary ─────────────────────────────────────────────────────────── -->
  <Color x:Key="Primary">#CC1A1A</Color>
  <Color x:Key="OnPrimary">#FFFFFF</Color>
  <Color x:Key="PrimaryContainer">#FFDAD6</Color>
  <Color x:Key="OnPrimaryContainer">#410002</Color>

  <!-- ── Secondary ───────────────────────────────────────────────────────── -->
  <Color x:Key="Secondary">#8B0000</Color>
  <Color x:Key="OnSecondary">#FFFFFF</Color>
  <Color x:Key="SecondaryContainer">#FFE0E0</Color>
  <Color x:Key="OnSecondaryContainer">#3D0000</Color>

  <!-- ── Tertiary ────────────────────────────────────────────────────────── -->
  <Color x:Key="Tertiary">#FF6B6B</Color>
  <Color x:Key="OnTertiary">#FFFFFF</Color>
  <Color x:Key="TertiaryContainer">#FFECEC</Color>
  <Color x:Key="OnTertiaryContainer">#5A0000</Color>

  <!-- ── Error ───────────────────────────────────────────────────────────── -->
  <Color x:Key="Error">#BA1A1A</Color>
  <Color x:Key="OnError">#FFFFFF</Color>
  <Color x:Key="ErrorContainer">#FFDAD6</Color>
  <Color x:Key="OnErrorContainer">#410002</Color>

  <!-- ── Surface Hierarchy ───────────────────────────────────────────────── -->
  <Color x:Key="Surface">#FFFBFF</Color>
  <Color x:Key="SurfaceDim">#E4D7D7</Color>
  <Color x:Key="SurfaceBright">#FFFBFF</Color>
  <Color x:Key="SurfaceContainerLowest">#FFFFFF</Color>
  <Color x:Key="SurfaceContainerLow">#FFF0F0</Color>
  <Color x:Key="SurfaceContainer">#FAEAEA</Color>
  <Color x:Key="SurfaceContainerHigh">#F4E4E4</Color>
  <Color x:Key="SurfaceContainerHighest">#EEDDDD</Color>
  <Color x:Key="SurfaceVariant">#F5E8E8</Color>
  <Color x:Key="OnSurface">#1C1B1B</Color>
  <Color x:Key="OnSurfaceVariant">#524343</Color>

  <!-- ── Outline ─────────────────────────────────────────────────────────── -->
  <Color x:Key="Outline">#857373</Color>
  <Color x:Key="OutlineVariant">#D8C2C2</Color>

  <!-- ── Special ─────────────────────────────────────────────────────────── -->
  <Color x:Key="Shadow">#000000</Color>
  <Color x:Key="Scrim">#000000</Color>
  <Color x:Key="InverseSurface">#322F2F</Color>
  <Color x:Key="InverseOnSurface">#FBEEEE</Color>
  <Color x:Key="InversePrimary">#FFB4AB</Color>

  <!-- ── Surgical Accent Palette (extended fModLoader tints/shades) ───── -->
  <Color x:Key="SurgicalRed50">#FFECEC</Color>
  <Color x:Key="SurgicalRed100">#FFDAD6</Color>
  <Color x:Key="SurgicalRed200">#FFB4AB</Color>
  <Color x:Key="SurgicalRed300">#FF897E</Color>
  <Color x:Key="SurgicalRed400">#FF6B6B</Color>
  <Color x:Key="SurgicalRed500">#CC1A1A</Color>
  <Color x:Key="SurgicalRed600">#8B0000</Color>
  <Color x:Key="SurgicalRed700">#690005</Color>
  <Color x:Key="SurgicalRed800">#410002</Color>
  <Color x:Key="SurgicalRed900">#2D0001</Color>

  <!-- ── Brush Resources ─────────────────────────────────────────────────── -->
  <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}" />
  <SolidColorBrush x:Key="OnPrimaryBrush" Color="{StaticResource OnPrimary}" />
  <SolidColorBrush x:Key="PrimaryContainerBrush" Color="{StaticResource PrimaryContainer}" />
  <SolidColorBrush x:Key="OnPrimaryContainerBrush" Color="{StaticResource OnPrimaryContainer}" />

  <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}" />
  <SolidColorBrush x:Key="OnSecondaryBrush" Color="{StaticResource OnSecondary}" />
  <SolidColorBrush x:Key="SecondaryContainerBrush" Color="{StaticResource SecondaryContainer}" />
  <SolidColorBrush x:Key="OnSecondaryContainerBrush" Color="{StaticResource OnSecondaryContainer}" />

  <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}" />
  <SolidColorBrush x:Key="OnTertiaryBrush" Color="{StaticResource OnTertiary}" />
  <SolidColorBrush x:Key="TertiaryContainerBrush" Color="{StaticResource TertiaryContainer}" />

  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Surface}" />
  <SolidColorBrush x:Key="SurfaceContainerBrush" Color="{StaticResource SurfaceContainer}" />
  <SolidColorBrush x:Key="SurfaceContainerLowBrush" Color="{StaticResource SurfaceContainerLow}" />
  <SolidColorBrush x:Key="SurfaceContainerHighBrush" Color="{StaticResource SurfaceContainerHigh}" />
  <SolidColorBrush x:Key="SurfaceContainerHighestBrush" Color="{StaticResource SurfaceContainerHighest}" />
  <SolidColorBrush x:Key="SurfaceVariantBrush" Color="{StaticResource SurfaceVariant}" />
  <SolidColorBrush x:Key="OnSurfaceBrush" Color="{StaticResource OnSurface}" />
  <SolidColorBrush x:Key="OnSurfaceVariantBrush" Color="{StaticResource OnSurfaceVariant}" />

  <SolidColorBrush x:Key="SurfaceContainerLowestBrush" Color="{StaticResource SurfaceContainerLowest}" />

  <SolidColorBrush x:Key="OutlineBrush" Color="{StaticResource Outline}" />
  <SolidColorBrush x:Key="OutlineVariantBrush" Color="{StaticResource OutlineVariant}" />

  <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource Error}" />
  <SolidColorBrush x:Key="ErrorContainerBrush" Color="{StaticResource ErrorContainer}" />
  <SolidColorBrush x:Key="OnErrorContainerBrush" Color="{StaticResource OnErrorContainer}" />

</ResourceDictionary>
